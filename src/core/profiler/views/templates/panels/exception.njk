{% import "macros/icons.njk" as icons %}
<div class="panel-title">{{ icons.icon("exception") }} Exceptions</div>
{% if panelData.noException %}
<div class="empty-state">
  <div class="empty-icon">✅</div>
  <div class="empty-text">No exceptions were thrown during this request.</div>
</div>
{% else %}
  {% if panelData.showBanner %}
  <div style="background:var(--warn-bg);border:1px solid #c62828;border-radius:6px;padding:16px 20px;margin-bottom:20px;">
    <div style="font-weight:700;font-size:13px;color:#e74c3c;margin-bottom:6px;">
      {{ icons.icon("exception") }} HTTP {{ panelData.statusCode }} — {{ panelData.statusMessage }}
    </div>
    <div style="font-family:monospace;font-size:12px;color:#999;">
      {{ panelData.method }} {{ panelData.url }}
    </div>
  </div>
  {% endif %}
  {% for l in panelData.errLogs %}
  <div style="background:#1e1a1a;border:1px solid #c62828;border-radius:6px;padding:14px 18px;margin-bottom:12px;">
    <div style="font-weight:700;font-size:13px;color:#e74c3c;margin-bottom:6px;">{{ l.levelUpper }}</div>
    <pre style="font-size:12px;color:#e0e0e0;white-space:pre-wrap;">{{ l.message }}</pre>
    {% if l.contextJson %}<pre class="json-pre" style="margin-top:10px;">{{ l.contextJson }}</pre>{% endif %}
  </div>
  {% endfor %}
{% endif %}
