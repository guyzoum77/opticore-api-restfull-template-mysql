{% from "macros/tables.njk" import kv_table %}
<div class="panel-title">Performance metrics</div>

<div class="perf-metrics-row">
  <div class="perf-metric">
    <div class="perf-metric-label">Total execution time</div>
    <div class="perf-metric-value">{{ panelData.total }}<span class="perf-metric-unit">ms</span></div>
  </div>
  <div class="perf-metric">
    <div class="perf-metric-label">Application time</div>
    <div class="perf-metric-value">{{ panelData.appTime }}<span class="perf-metric-unit">ms</span></div>
  </div>
  <div class="perf-metric">
    <div class="perf-metric-label">Peak memory usage</div>
    <div class="perf-metric-value">{{ panelData.memoryMiB }}<span class="perf-metric-unit"> MiB</span></div>
  </div>
</div>

<div class="panel-section">
  <div class="panel-section-title">Execution timeline</div>

  <div class="tl-threshold-row">
    Threshold
    <input type="number" class="tl-threshold-input" id="tl-threshold" value="0" min="0" max="{{ panelData.total }}">
    ms
    <span class="tl-threshold-hint">(timeline only displays events with a duration longer than this threshold)</span>
  </div>

  <div class="tl-legend">
    <span class="tl-legend-item"><span class="tl-legend-dot" style="background:#C87A3C;"></span> application</span>
    {% if panelData.hasSqlTime %}<span class="tl-legend-item"><span class="tl-legend-dot" style="background:#2D6A4A;"></span> database</span>{% endif %}
  </div>

  <div class="tl-chart">
    {% if panelData.hasEvents %}
      {% for e in panelData.events %}
      <div class="tl-row">
        <div class="tl-name">{{ e.label }}</div>
        <div class="tl-track">
          <div class="tl-bar" style="width:{{ e.widthPct }}%;background:{{ e.color }};">
            <span class="tl-bar-label">{{ e.durationFormatted }}</span>
          </div>
        </div>
        <div class="tl-info">{{ e.durationFormatted }}</div>
      </div>
      {% endfor %}
    {% else %}
    <div class="tl-empty">No timing events recorded for this request.</div>
    {% endif %}
  </div>
</div>

<div class="panel-section">
  <div class="panel-section-title">Process Info</div>
  <div class="table-wrap">{{ kv_table(panelData.processInfo) }}</div>
</div>
