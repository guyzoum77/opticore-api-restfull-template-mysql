{% import "macros/icons.njk" as icons %}
{% macro route_table(rows) %}
{%- if rows.length == 0 -%}
<div style="padding:14px;color:var(--muted);font-size:12px;text-align:center;">None</div>
{%- else -%}
<table class="data-table">
  <thead><tr><th>Method</th><th>Path</th><th style="text-align:center;">Middlewares</th></tr></thead>
  <tbody>
    {%- for r in rows %}
    <tr>
      <td><span class="route-method {{ r.methodClass }}">{{ r.method }}</span></td>
      <td class="route-path">{% for seg in r.pathSegments %}{% if seg.type == "param" %}<span class="param">:{{ seg.value }}</span>{% else %}{{ seg.value }}{% endif %}{% endfor %}</td>
      <td class="center mono muted">{{ r.middlewareCount }}</td>
    </tr>
    {%- endfor %}
  </tbody>
</table>
{%- endif -%}
{% endmacro %}

{% if not panelData.hasRoutes %}
<div class="panel-title">{{ icons.icon("map") }} Routes</div>
<div class="empty-state">
  <div class="empty-icon">🗺</div>
  <div class="empty-text">No routes found. Routes are collected after the server starts.</div>
</div>
{% else %}
<div class="panel-title">{{ icons.icon("map") }} Routes</div>

<div class="routes-summary">
  <div class="routes-summary-item"><div class="routes-summary-value">{{ panelData.totalRoutes }}</div><div class="routes-summary-label">Total Routes</div></div>
  <div class="routes-summary-item"><div class="routes-summary-value">{{ panelData.appRoutesCount }}</div><div class="routes-summary-label">App Routes</div></div>
  {% for mc in panelData.methodCounts %}
  <div class="routes-summary-item"><div class="routes-summary-value">{{ mc.count }}</div><div class="routes-summary-label">{{ mc.method }}</div></div>
  {% endfor %}
</div>

{% if panelData.hasAppRoutes %}
<div class="panel-section">
  <div class="panel-section-title">Application Routes <span class="badge badge-info">{{ panelData.appRoutesCount }}</span></div>
  <div class="table-wrap">{{ route_table(panelData.appRoutesRows) }}</div>
</div>
{% endif %}

{% if panelData.hasDebugRoutes %}
<div class="panel-section">
  <div class="panel-section-title">Framework / Debug Routes <span class="badge badge-muted">{{ panelData.debugRoutesRows.length }}</span></div>
  <div class="table-wrap">{{ route_table(panelData.debugRoutesRows) }}</div>
</div>
{% endif %}
{% endif %}
