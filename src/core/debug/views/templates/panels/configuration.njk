{% import "macros/icons.njk" as icons %}
{% from "macros/tables.njk" import kv_table %}
<div class="panel-title">{{ icons.icon("config") }} Configuration</div>

<div class="panel-section">
  <div class="panel-section-title">App Info</div>
  <div class="table-wrap">{{ kv_table(panelData.appInfo) }}</div>
</div>

<div class="panel-section">
  <div class="panel-section-title">Environment Variables <span class="badge badge-muted">{{ panelData.envCount }}</span></div>
  <div class="table-wrap">
    <div class="table-wrap-title">Environment <input type="search" class="table-search" placeholder="Filter…" oninput="filterTable(this)"></div>
    {{ kv_table(panelData.envRows, headers=["Key","Value"]) }}
  </div>
</div>
